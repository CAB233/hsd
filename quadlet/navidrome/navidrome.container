[Container]
ContainerName=navidrome
Image=ghcr.io/navidrome/navidrome:0.64.2
AutoUpdate=registry
NoNewPrivileges=true
SecurityLabelDisable=true

Environment=ND_MUSICFOLDER=/music
Environment=ND_DATAFOLDER=/data
Environment=ND_PORT=4533
Environment=ND_ENABLEINSIGHTSCOLLECTOR=false
Environment=ND_DEFAULTLANGUAGE=zh-Hans

Volume=%h/music:/music:z,ro
Volume=navidrome_data.volume:/data:Z

Network=caddy.network

[Service]
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=default.target
